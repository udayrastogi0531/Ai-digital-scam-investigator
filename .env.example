# ---- AI Digital Scam Investigator — docker-compose template ---------------
# Copy to .env at the repository root and adjust: this file configures the
# containerised stack started by `docker compose up`.
#
# Local, non-Docker development: use backend/.env.example instead.  The
# DATABASE_URL below points at the compose service name (postgres), which a
# local shell cannot reach unless PostgreSQL is running on that exact host.
#
# Without API keys the application runs in a safe DEMO mode: deterministic
# explanations, mock threat intelligence, mock OCR.  Nothing here is required
# for the default local/docker experience.

# --- Database (used by docker-compose) ---
DATABASE_URL=postgresql+asyncpg://scaminv:scaminv@postgres:5432/scaminv
# Local (no Postgres): sqlite+aiosqlite:///./data/app.db
# Password for the bundled postgres service (change for anything shared):
POSTGRES_PASSWORD=scaminv

# --- Authentication (REQUIRED for any real deployment) ---
# Signing key for access tokens.  Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left unset the app uses an insecure development key and warns at startup.
AUTH_SECRET_KEY=
# AUTH_TOKEN_EXPIRE_MINUTES=1440

# --- LLM provider (optional; "mock" is the default) ---
LLM_PROVIDER=mock            # mock | openai_compatible
LLM_API_KEY=
LLM_BASE_URL=                # e.g. https://api.openai.com/v1 (or a local-compatible endpoint)
LLM_MODEL=gpt-4o-mini

# --- Threat intelligence (optional) ---
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
THREAT_INTEL_TIMEOUT_SECONDS=10
# Opt-in switches for tests/test_threat_intel_live.py (never set in CI):
# RUN_LIVE_INTEL_TESTS=1  # live Google Safe Browsing / VirusTotal checks (needs keys above)
# RUN_LIVE_LLM_TESTS=1    # live LLM grounding check (needs LLM_PROVIDER=openai_compatible + LLM_API_KEY)

# --- OCR (optional; auto-detects tesseract, falls back to mock) ---
OCR_PROVIDER=auto            # auto | tesseract | mock
TESSERACT_BINARY=tesseract

# --- Limits / security ---
MAX_UPLOAD_MB=10
MAX_TEXT_LENGTH=50000
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_IMAGE_OPS=4   # per-process cap on concurrent image/OCR investigations (503 beyond it)
