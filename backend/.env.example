# Backend environment template — copy to backend/.env and edit.
#
# Nothing here is required. With every value left blank the application runs in
# DEMO mode: deterministic explanations, mock threat intelligence, mock OCR and
# the verified local SQLite store. No network calls, no keys, no database server.
#
#   cp backend/.env.example backend/.env
#
# backend/.env is git-ignored. Never commit it, and never paste a key into a URL
# query parameter or into an issue.

# --- Database -----------------------------------------------------------------
# Leave DATABASE_URL unset for local development: the app uses SQLite at
# backend/data/app.db (git-ignored). Uncomment the next line only if you are
# running PostgreSQL and have a reachable server:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/scaminv
#
# For the containerised stack, use the repository's root .env.example instead —
# it points DATABASE_URL at the compose service name (postgres), not localhost.

# --- Authentication (required for any real deployment) ------------------------
# Access tokens are signed with this key.  Any deployment that is reachable by
# more than you MUST set it.  Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset, the app falls back to an insecure development key and warns at startup.
AUTH_SECRET_KEY=
# AUTH_TOKEN_EXPIRE_MINUTES=1440     # access-token lifetime (default 24h)
# AUTH_PASSWORD_MIN_LENGTH=8

# --- LLM (optional; "mock" is the default) ------------------------------------
LLM_PROVIDER=mock            # mock | openai_compatible
LLM_API_KEY=
LLM_BASE_URL=                # any OpenAI-compatible /v1 base, e.g. https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gpt-4o-mini        # must be a model your key can access
# LLM_TIMEOUT_SECONDS=45

# --- Threat intelligence (optional) -------------------------------------------
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
# THREAT_INTEL_TIMEOUT_SECONDS=10

# --- OCR (optional; auto-detects the tesseract binary, falls back to a mock) ---
OCR_PROVIDER=auto            # auto | tesseract | mock
TESSERACT_BINARY=tesseract

# --- Limits / security --------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_TEXT_LENGTH=50000
MAX_URLS_PER_SUBMISSION=20
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_IMAGE_OPS=4   # per-process cap on concurrent image/OCR investigations (503 beyond it)
# CORS_ORIGINS=["http://localhost:3000"]   # only needed if the browser calls the API directly
# RISK_WEIGHTS_PATH=                        # optional JSON overrides for the risk weights
DEBUG=false

# --- Opt-in live test suites (never set in CI) --------------------------------
# RUN_LIVE_INTEL_TESTS=1   # live Google Safe Browsing / VirusTotal checks (needs the keys above)
# RUN_LIVE_LLM_TESTS=1     # live LLM grounding check (needs LLM_PROVIDER=openai_compatible + LLM_API_KEY)
# RUN_LIVE_OCR_TESTS=1     # live OCR contracts (needs a system tesseract binary)
