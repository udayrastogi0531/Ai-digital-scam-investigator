# fresh checkout can run the calibration tests and real-data pipeline.
!backend/data/datasets/
backend/data/datasets/*
!backend/data/datasets/.gitkeep
!backend/data/datasets/README.md
!backend/data/datasets/real/
!backend/data/datasets/real/**
!backend/data/evaluation/
backend/data/evaluation/*
!backend/data/evaluation/evaluation_cases.json
backend/data/uploads/
*.db

